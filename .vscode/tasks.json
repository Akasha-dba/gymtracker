{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build Debug APK",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "gradlew.bat"
      },
      "args": ["assembleDebug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Install APK to Samsung (ADB)",
      "type": "shell",
      "command": "adb",
      "args": ["install", "-r", "app/build/outputs/apk/debug/app-debug.apk"],
      "dependsOn": "Android: Build Debug APK",
      "problemMatcher": []
    }
  ]
}
